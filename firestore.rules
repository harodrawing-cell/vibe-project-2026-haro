rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public test board only. No administrator account. Expires 2026-12-06 UTC.
    match /notices/{id} {
      allow read, delete: if request.time < timestamp.date(2026, 12, 6);
      allow create, update: if request.time < timestamp.date(2026, 12, 6)
        && request.resource.data.keys().hasAll(['id', 'category', 'title', 'content', 'author', 'imageUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'category', 'title', 'content', 'author', 'imageUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.category in ['공지사항', '이모티콘', '굿즈', '사이트 소식']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 30000
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 120
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 950000
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() == 24
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() == 24;
    }
  }
}
